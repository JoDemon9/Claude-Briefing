# Reference template for the deployed private workflow. Also copy private-prefetch-window.py.example to private .github/prefetch_window.py.
name: Prepare private synthesis pack (Python only)
on:
  schedule:
    # Four preparation attempts per edition; Python selects Athens time across DST.
    - cron: '7,22,37,52 3-5,9-11,15-17 * * *'
  workflow_dispatch:
    inputs:
      slot:
        type: choice
        options: [morning, midday, evening]
        required: true
permissions:
  contents: write
concurrency:
  group: private-research-packs
  cancel-in-progress: false
jobs:
  prepare:
    if: github.ref == 'refs/heads/main'
    runs-on: ubuntu-latest
    timeout-minutes: 8
    steps:
      - uses: actions/checkout@v4
        with:
          path: private
      - name: Select the preparation window before expensive work
        id: window
        env:
          EVENT: ${{ github.event_name }}
          SLOT: ${{ inputs.slot }}
        run: python private/.github/prefetch_window.py --event "$EVENT" --slot "$SLOT" --github-output "$GITHUB_OUTPUT"
      - uses: actions/checkout@v4
        if: steps.window.outputs.slot != ''
        with:
          repository: JoDemon9/Claude-Briefing
          ref: main
          path: source
          persist-credentials: false
      - uses: actions/checkout@v4
        if: steps.window.outputs.slot != ''
        with:
          repository: JoDemon9/oracle-briefing
          ref: main
          path: portal
          persist-credentials: false
      - uses: actions/setup-python@v5
        if: steps.window.outputs.slot != ''
        with:
          python-version: '3.12'
      - name: Verify submission credential without changing any refs
        if: steps.window.outputs.slot != ''
        id: credential
        continue-on-error: true
        env:
          ORACLE_PUBLIC_PUSH_TOKEN: ${{ secrets.PUBLIC_BRIEFING_TOKEN }}
        run: |
          python - <<'PY'
          import importlib.util
          import os
          from pathlib import Path
          if not os.environ.get('ORACLE_PUBLIC_PUSH_TOKEN'):
              raise SystemExit('PUBLIC_BRIEFING_TOKEN is missing; submission_ready will be false.')
          spec = importlib.util.spec_from_file_location('publisher', 'source/scripts/v2/publish.py')
          publisher = importlib.util.module_from_spec(spec)
          spec.loader.exec_module(publisher)
          publisher.GitPublisher(Path('source'), 'public').preflight()
          print('PUBLIC_BRIEFING_TOKEN: Contents write preflight passed; no refs changed.')
          PY
      - run: pip install beautifulsoup4
        if: steps.window.outputs.slot != ''
      - uses: actions/cache@v4
        if: steps.window.outputs.slot != ''
        with:
          path: |
            private/research/source-cache
            private/research/news-state.json
          key: prefetch-${{ github.run_id }}
          restore-keys: prefetch-
      - name: Collect without invoking AI
        if: steps.window.outputs.slot != ''
        id: prepare
        env:
          EVENT: ${{ github.event_name }}
          SLOT: ${{ inputs.slot }}
          ORACLE_SUBMISSION_READY: ${{ steps.credential.outcome == 'success' }}
        run: |
          PREP_SLOT="$(python private/.github/prefetch_window.py --event "$EVENT" --slot "$SLOT" --print-slot)"
          if [ -z "$PREP_SLOT" ]; then
            echo 'Preparation window closed during setup; no collection or AI invocation.'
            exit 0
          fi
          python source/scripts/v2/pre_run.py --root source --private-root private --wire-root portal --slot "$PREP_SLOT" --github-output "$GITHUB_OUTPUT"
      - name: Save only the private pack and digest
        if: steps.prepare.outputs.edition_id != ''
        working-directory: private
        env:
          EDITION: ${{ steps.prepare.outputs.edition_id }}
        run: |
          git config user.name 'Oracle Python Prefetch'
          git config user.email 'actions@github.com'
          git add -- "research/runs/$EDITION/research_pack.json" "research/runs/$EDITION/digest.md"
          if ! git diff --cached --quiet; then
            git commit -m "Prepare $EDITION synthesis pack (no AI)"
            git pull --rebase --autostash origin main
            git push origin HEAD:main
          fi
