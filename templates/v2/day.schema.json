{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "date",
    "timezone",
    "status",
    "url",
    "created_at",
    "updated_at",
    "input_sha256",
    "lead_story_id",
    "missing_slots",
    "editions",
    "stories",
    "updates"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "timezone": {
      "enum": [
        "Europe/Athens",
        "Asia/Nicosia"
      ]
    },
    "status": {
      "const": "published"
    },
    "url": {
      "type": "string",
      "pattern": "^daily/\\d{4}-\\d{2}-\\d{2}\\.html$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "input_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "lead_story_id": {
      "type": "string"
    },
    "missing_slots": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "morning",
          "midday",
          "evening"
        ]
      }
    },
    "editions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "url",
          "published_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}-(morning|midday|evening)$"
          },
          "type": {
            "enum": [
              "morning",
              "midday",
              "evening"
            ]
          },
          "url": {
            "type": "string",
            "pattern": "^(morning|midday|evening|briefings)/\\d{4}-\\d{2}-\\d{2}\\.html$"
          },
          "published_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "stories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "story_id",
          "first_seen_at",
          "last_substantive_at",
          "references",
          "selected",
          "section",
          "priority"
        ],
        "properties": {
          "story_id": {
            "type": "string"
          },
          "first_seen_at": {
            "type": "string",
            "format": "date-time"
          },
          "last_substantive_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "references": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "edition_id",
                "url"
              ],
              "properties": {
                "edition_id": {
                  "type": "string"
                },
                "article_id": {
                  "type": "string"
                },
                "source_story_id": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                }
              }
            }
          },
          "selected": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "edition_id",
              "url"
            ],
            "properties": {
              "edition_id": {
                "type": "string"
              },
              "article_id": {
                "type": "string"
              },
              "source_story_id": {
                "type": "string"
              },
              "url": {
                "type": "string"
              }
            }
          },
          "section": {
            "enum": [
              "cyprus",
              "world",
              "sports"
            ]
          },
          "priority": {
            "type": "integer"
          }
        }
      }
    },
    "updates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "at",
          "summary",
          "source_urls",
          "story_id",
          "origin"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "new",
              "substantive_update",
              "correction",
              "enrichment",
              "provenance"
            ]
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "summary": {
            "type": "string",
            "minLength": 10
          },
          "source_urls": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://"
            }
          },
          "story_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "origin": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "edition_id",
              "url"
            ],
            "properties": {
              "edition_id": {
                "type": "string"
              },
              "article_id": {
                "type": "string"
              },
              "source_story_id": {
                "type": "string"
              },
              "url": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "overview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "points"
      ],
      "properties": {
        "kind": {
          "enum": [
            "reviewed",
            "selected_summaries"
          ]
        },
        "points": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "text",
              "story_ids"
            ],
            "properties": {
              "text": {
                "type": "string",
                "minLength": 20
              },
              "story_ids": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "opportunities": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/opportunity"
      }
    },
    "follow_ups": {
      "type": "array",
      "maxItems": 50,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from_story_id",
          "to_story_id",
          "reviewed_in"
        ],
        "properties": {
          "from_story_id": {
            "type": "string",
            "minLength": 1
          },
          "to_story_id": {
            "type": "string",
            "minLength": 1
          },
          "reviewed_in": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}-(morning|midday|evening)$"
          }
        }
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": [
        "publisher",
        "url",
        "published_at",
        "retrieved_at",
        "reporting_group",
        "kind",
        "access"
      ],
      "properties": {
        "publisher": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "published_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "retrieved_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "reporting_group": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "enum": [
            "primary",
            "reporting",
            "wire",
            "context"
          ]
        },
        "access": {
          "enum": [
            "read",
            "archived",
            "inaccessible"
          ]
        },
        "used_for_claims": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "opportunity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "jurisdiction",
        "summary",
        "eligibility",
        "support",
        "deadline_note",
        "action",
        "kind",
        "status",
        "verified_at",
        "deadline",
        "opens_at",
        "deadline_type",
        "application_url",
        "application_kind",
        "sources"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "jurisdiction": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "eligibility": {
          "type": "string",
          "minLength": 1
        },
        "support": {
          "type": "string",
          "minLength": 1
        },
        "deadline_note": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "grant",
            "benefit",
            "legal_right"
          ]
        },
        "status": {
          "enum": [
            "open",
            "upcoming",
            "closed",
            "proposed",
            "needs_verification"
          ]
        },
        "verified_at": {
          "type": "string",
          "format": "date-time"
        },
        "deadline": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\d{4}-\\d{2}-\\d{2}(T.*)?$"
        },
        "opens_at": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\d{4}-\\d{2}-\\d{2}(T.*)?$"
        },
        "deadline_type": {
          "enum": [
            "fixed",
            "rolling",
            "unknown"
          ]
        },
        "application_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "application_kind": {
          "enum": [
            "form",
            "instructions",
            "none"
          ]
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "change_note": {
          "type": "string"
        }
      }
    }
  }
}
