{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "source": {
      "type": "object",
      "required": [
        "publisher",
        "url",
        "published_at",
        "retrieved_at",
        "reporting_group",
        "kind",
        "access"
      ],
      "properties": {
        "publisher": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "published_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "retrieved_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "reporting_group": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "enum": [
            "primary",
            "reporting",
            "wire",
            "context"
          ]
        },
        "access": {
          "enum": [
            "read",
            "archived",
            "inaccessible"
          ]
        },
        "used_for_claims": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "article": {
      "type": "object",
      "required": [
        "id",
        "story_id",
        "edition_id",
        "headline",
        "category",
        "summary",
        "published_at",
        "updated_at",
        "sources",
        "sections",
        "image",
        "related_story_ids",
        "url"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "story_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "edition_id": {
          "type": "string"
        },
        "headline": {
          "type": "string",
          "minLength": 5
        },
        "category": {
          "enum": [
            "Πρώτο θέμα",
            "Κύπρος",
            "Διεθνή",
            "Αθλητικά"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 20
        },
        "published_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "sections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "kind",
              "heading",
              "paragraphs"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "reported",
                  "analysis"
                ]
              },
              "heading": {
                "type": "string",
                "minLength": 2
              },
              "paragraphs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 10
                }
              }
            },
            "additionalProperties": false
          }
        },
        "image": {
          "type": [
            "object",
            "null"
          ],
          "required": [
            "url",
            "alt",
            "attribution"
          ],
          "properties": {
            "url": {
              "type": "string"
            },
            "alt": {
              "type": "string"
            },
            "attribution": {
              "type": "string",
              "minLength": 3
            },
            "caption": {
              "type": "string",
              "minLength": 3
            },
            "license": {
              "type": "string",
              "minLength": 3
            },
            "source_url": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://"
            },
            "original_url": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://"
            },
            "license_url": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://"
            },
            "retrieved_at": {
              "type": "string",
              "format": "date-time"
            },
            "download_url": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://"
            },
            "reuse_review": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source_asset",
                "sha256",
                "reviewed_at",
                "relevance_and_archive_date_checked"
              ],
              "properties": {
                "source_asset": {
                  "type": "string",
                  "pattern": "^assets/editorial/"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "reviewed_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "relevance_and_archive_date_checked": {
                  "const": true
                }
              }
            }
          }
        },
        "related_story_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "url": {
          "type": "string",
          "pattern": "^articles/\\d{4}-\\d{2}-\\d{2}-(morning|midday|evening)/[a-z0-9-]+\\.html$"
        },
        "evidence_note": {
          "type": "string"
        },
        "image_unavailable_reason": {
          "type": "string",
          "minLength": 15
        },
        "newspaper_analysis": {
          "type": "array",
          "minItems": 0,
          "maxItems": 4,
          "items": {
            "type": "string",
            "minLength": 20
          }
        },
        "revision_note": {
          "type": "string"
        },
        "daily": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "section": {
              "enum": [
                "cyprus",
                "world",
                "sports"
              ]
            },
            "priority": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "events": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "kind",
                  "at",
                  "summary",
                  "source_urls"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "kind": {
                    "enum": [
                      "new",
                      "substantive_update",
                      "correction",
                      "enrichment",
                      "provenance"
                    ]
                  },
                  "at": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "summary": {
                    "type": "string",
                    "minLength": 10
                  },
                  "source_urls": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "format": "uri",
                      "pattern": "^https://"
                    }
                  }
                }
              }
            }
          }
        },
        "reader_mode": {
          "enum": [
            "full",
            "source"
          ]
        },
        "analysis_sources": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uri"
          }
        },
        "reader_value": {
          "type": "string",
          "minLength": 15
        },
        "sports_interest": {
          "enum": [
            "omonoia",
            "manutd",
            "realmadrid",
            "formula1",
            "other"
          ]
        },
        "freshness": {
          "$ref": "#/$defs/freshness"
        },
        "story_identity": {
          "type": "string",
          "minLength": 8,
          "maxLength": 240,
          "description": "Editorial event identity, stable across updates; e.g. subject/event/date. Never inferred from headline similarity."
        },
        "delta_update": {
          "type": "string",
          "description": "Midday delta update callout or breaking developments since morning"
        },
        "mechanics_and_incentives": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ],
          "description": "Layer 2: Underlying economic/political mechanics and actor incentives"
        },
        "second_order_effects": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ],
          "description": "Layer 3: Unintended consequences and ripple effects"
        },
        "scenarios": {
          "type": "object",
          "properties": {
            "base_case": {
              "type": "string"
            },
            "tail_risk": {
              "type": "string"
            },
            "watch_next": {
              "type": "string"
            },
            "alternative_case": {
              "type": "string"
            },
            "alternative_label": {
              "type": "string",
              "maxLength": 60
            }
          },
          "additionalProperties": true,
          "description": "Layer 4: Sovereign forward-looking scenarios"
        },
        "driver_tags": {
          "type": "array",
          "maxItems": 12,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 48,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        },
        "change_status": {
          "enum": [
            "NEW",
            "UPDATED",
            "REVERSAL",
            "CORRECTION",
            "UNCHANGED",
            "UNKNOWN"
          ]
        },
        "baseline_origin": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "edition_id",
            "fingerprint"
          ],
          "properties": {
            "edition_id": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}-(morning|midday|evening)$"
            },
            "fingerprint": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        }
      },
      "additionalProperties": false
    },
    "match": {
      "type": "object",
      "required": [
        "opponent",
        "competition",
        "date",
        "result",
        "venue",
        "scorers",
        "verified_at",
        "sources"
      ],
      "properties": {
        "opponent": {
          "type": "string"
        },
        "competition": {
          "type": "string"
        },
        "date": {
          "type": "string"
        },
        "result": {
          "type": "string"
        },
        "venue": {
          "type": [
            "string",
            "null"
          ]
        },
        "scorers": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "verified_at": {
          "type": "string",
          "format": "date-time"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source"
          }
        }
      },
      "additionalProperties": false
    },
    "fixture": {
      "type": "object",
      "required": [
        "opponent",
        "competition",
        "date",
        "venue",
        "kickoff_at",
        "verified_at",
        "sources"
      ],
      "properties": {
        "opponent": {
          "type": "string"
        },
        "competition": {
          "type": "string"
        },
        "date": {
          "type": "string"
        },
        "venue": {
          "type": [
            "string",
            "null"
          ]
        },
        "kickoff_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "verified_at": {
          "type": "string",
          "format": "date-time"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "verification_note": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "update": {
      "type": "object",
      "required": [
        "published_at",
        "status",
        "text",
        "sources"
      ],
      "properties": {
        "published_at": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}(T.*)?$"
        },
        "status": {
          "type": "string"
        },
        "text": {
          "type": "string",
          "minLength": 15
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source"
          }
        }
      },
      "additionalProperties": false
    },
    "sports_team": {
      "type": "object",
      "required": [
        "analysis"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "status_badge": {
          "type": "string"
        },
        "last_result": {
          "type": "string"
        },
        "editorial_summary": {
          "type": "string"
        },
        "verified_links": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "title",
              "url"
            ],
            "properties": {
              "title": {
                "type": "string"
              },
              "url": {
                "type": "string"
              },
              "source": {
                "type": "string"
              }
            }
          }
        },
        "symbol": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "updated_at": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}(T.*)?$"
        },
        "last_match": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/match"
            }
          ]
        },
        "next_fixture": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/fixture"
            }
          ]
        },
        "analysis": {
          "type": "string"
        },
        "watch_next": {
          "type": "string"
        },
        "league_position": {
          "type": [
            "string",
            "null"
          ]
        },
        "form": {
          "type": [
            "string",
            "null"
          ]
        },
        "updates": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "$ref": "#/$defs/update"
          }
        },
        "no_update_reason": {
          "type": "string"
        },
        "latest_session": {
          "type": [
            "object",
            "null"
          ]
        },
        "next_grand_prix": {
          "type": [
            "string",
            "null"
          ]
        },
        "sessions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "starts_at",
              "sources"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "starts_at": {
                "type": "string",
                "format": "date-time"
              },
              "sources": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/source"
                }
              }
            },
            "additionalProperties": false
          }
        },
        "next_gp_sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "session_times_reason": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "opportunity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "jurisdiction",
        "summary",
        "eligibility",
        "support",
        "deadline_note",
        "action",
        "kind",
        "status",
        "verified_at",
        "deadline",
        "opens_at",
        "deadline_type",
        "application_url",
        "application_kind",
        "sources"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "jurisdiction": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "eligibility": {
          "type": "string",
          "minLength": 1
        },
        "support": {
          "type": "string",
          "minLength": 1
        },
        "deadline_note": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "grant",
            "benefit",
            "legal_right"
          ]
        },
        "status": {
          "enum": [
            "open",
            "upcoming",
            "closed",
            "proposed",
            "needs_verification"
          ]
        },
        "verified_at": {
          "type": "string",
          "format": "date-time"
        },
        "deadline": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\d{4}-\\d{2}-\\d{2}(T.*)?$"
        },
        "opens_at": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\d{4}-\\d{2}-\\d{2}(T.*)?$"
        },
        "deadline_type": {
          "enum": [
            "fixed",
            "rolling",
            "unknown"
          ]
        },
        "application_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "application_kind": {
          "enum": [
            "form",
            "instructions",
            "none"
          ]
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "change_note": {
          "type": "string"
        },
        "review_due": {
          "type": "boolean"
        }
      }
    },
    "freshness": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "label",
          "checked_at",
          "sources"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "kind": {
            "enum": [
              "weather",
              "warning",
              "event",
              "recheck"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 3
          },
          "checked_at": {
            "type": "string",
            "format": "date-time"
          },
          "valid_from": {
            "type": "string",
            "format": "date-time"
          },
          "valid_until": {
            "type": "string",
            "format": "date-time"
          },
          "starts_at": {
            "type": "string",
            "format": "date-time"
          },
          "ends_at": {
            "type": "string",
            "format": "date-time"
          },
          "recheck_at": {
            "type": "string",
            "format": "date-time"
          },
          "historical_context": {
            "type": "boolean"
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://"
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "enum": [
                    "weather",
                    "warning"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "valid_from",
                "valid_until",
                "recheck_at"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "event"
                }
              }
            },
            "then": {
              "required": [
                "starts_at",
                "recheck_at"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "recheck"
                }
              }
            },
            "then": {
              "required": [
                "recheck_at"
              ]
            }
          }
        ]
      }
    },
    "favourite_news_item": {
      "type": "object",
      "required": [
        "url",
        "headline",
        "published_at",
        "retrieved_at"
      ],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "headline": {
          "type": "string",
          "minLength": 12,
          "maxLength": 280
        },
        "headline_el": {
          "type": "string",
          "minLength": 8,
          "maxLength": 280
        },
        "published_at": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\d{4}-\\d{2}-\\d{2}(T.*)?$"
        },
        "retrieved_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "favourite_news_check": {
      "type": "object",
      "required": [
        "source_url",
        "checked_at",
        "status",
        "items",
        "note"
      ],
      "properties": {
        "source_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "checked_at": {
          "type": "string",
          "format": "date-time"
        },
        "status": {
          "enum": [
            "available",
            "cached",
            "unavailable"
          ]
        },
        "items": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/favourite_news_item"
          }
        },
        "note": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 160
        },
        "attempted_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "date",
    "type",
    "timezone",
    "published_at",
    "status",
    "title",
    "url",
    "articles",
    "changes",
    "sports",
    "markets"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "id": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}-(morning|midday|evening)$"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "type": {
      "enum": [
        "morning",
        "midday",
        "evening"
      ]
    },
